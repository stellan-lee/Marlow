# Copy to ~/.marlow/config.yaml (or the selected Marlow profile).
# Model/provider configuration is native Codex TOML in:
#   <profile>/runtime/codex/config.toml
# Install Codex 0.159.2 and run `marlow login` for independent profile auth.
runtime:
  codex:
    binary: ""                 # absolute path, or discover codex on host PATH
    turn_timeout: 600
    max_concurrent: 4
    pass_env: []                # explicit provider env_key / proxy / CA opt-ins
    projects: []                # [{path: /absolute/project, writable: true}]
    skills: []                  # explicitly authorized extra skill directories

toolsets: [marlow-cli]
agent:
  max_turns: 90                 # maximum completed tool operations per Codex turn
  gateway_timeout: 1800
  restart_drain_timeout: 180
  clarify_timeout: 600
  disabled_toolsets: []
terminal:
  backend: local               # Codex command/exec sandbox; no SSH/Docker fallback
memory:
  memory_enabled: true
  user_profile_enabled: true
  provider: ""                 # opt in to Honcho separately
streaming:
  enabled: true
